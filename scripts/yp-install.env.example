# Скопируйте в /tmp/yp-install.env и подставьте свои значения.
# Установка: sudo bash /tmp/yp-install.sh /tmp/yp-install.env

# --- Вариант A: клиент (чистая установка) ---
PROFILE=client
VARIANT=clean
KIT_URL=https://py.idivles.ru/backups/youngportal-client-kit-latest.tgz
PROD_DOMAIN=young.example.ru
STAGING_DOMAIN=tyoung.example.ru
LE_EMAIL=you@example.ru
ADMIN_EMAIL=admin@young.example.ru
SITE_NAME=Молодёжный портал
# ADMIN_PASSWORD=

# Функции сайта (модули): all | core | content | ключ1,ключ2
MODULES=all
# MODULES_OFF=games,eco

# --- Вариант B: заказчик с готовым контентом (полный клон) ---
# PROFILE=developer
# VARIANT=full
# KIT_URL=https://….tgz   # youngportal-customer-org-kit-*.tgz (по защищённому каналу)
# PROD_DOMAIN=portal.example.ru
# STAGING_DOMAIN=test.example.ru
# LE_EMAIL=ops@example.ru
# SITE_NAME=Молодёжный портал X
# MODULES=content
# MODULES_OFF=games,eco
# OLD_HOSTS=ty.idivles.ru,py.idivles.ru
# OLD_SITE_NAMES=Молодёжь Сочи

# --- Вариант C: разработчик (эталон) ---
# PROFILE=developer
# VARIANT=full
# KIT_URL=https://py.idivles.ru/backups/youngportal-reference-kit-latest.tgz
# PROD_DOMAIN=py.example.ru
# STAGING_DOMAIN=ty.example.ru
# LE_EMAIL=you@example.ru

# KIT_SHA256=  # необязательно: берётся из URL.sha256
# TLS_MODE=letsencrypt
# WORK_DIR=/var/tmp/yp-install
